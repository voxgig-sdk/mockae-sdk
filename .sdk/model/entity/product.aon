  op: {
    list: {
      name: "list"
      points: [
        {
          contract: {
            id: "GET /products"
            json: "{\"operationId\":\"getAllProducts\",\"parameters\":[],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"items\":{\"description\":\"Product object with details\",\"properties\":{\"category\":{\"description\":\"Product category\",\"example\":\"Electronics\",\"type\":\"string\"},\"description\":{\"description\":\"Product description\",\"example\":\"This is a sample product description\",\"type\":\"string\"},\"id\":{\"description\":\"Product ID\",\"example\":1,\"type\":\"integer\"},\"name\":{\"description\":\"Product name\",\"example\":\"Sample Product\",\"type\":\"string\"},\"price\":{\"description\":\"Product price\",\"example\":29.99,\"format\":\"float\",\"type\":\"number\"}},\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"Successful response with list of products\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/products"
          segments: [
            {
              lit: "products"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
