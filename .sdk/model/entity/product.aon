                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /products/{id}"
            json: "{\"operationId\":\"getProductById\",\"parameters\":[{\"description\":\"Product ID\",\"in\":\"path\",\"name\":\"id\",\"required\":true,\"schema\":{\"maximum\":50,\"minimum\":1,\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Product object with details\",\"properties\":{\"category\":{\"description\":\"Product category\",\"example\":\"Electronics\",\"type\":\"string\"},\"description\":{\"description\":\"Product description\",\"example\":\"This is a sample product description\",\"type\":\"string\"},\"id\":{\"description\":\"Product ID\",\"example\":1,\"type\":\"integer\"},\"name\":{\"description\":\"Product name\",\"example\":\"Sample Product\",\"type\":\"string\"},\"price\":{\"description\":\"Product price\",\"example\":29.99,\"format\":\"float\",\"type\":\"number\"}},\"type\":\"object\"}}},\"description\":\"Successful response with product details\"},\"404\":{\"description\":\"Product not found\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/products/{id}"
          segments: [
