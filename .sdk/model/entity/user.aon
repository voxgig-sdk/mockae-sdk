  }

  name: "user"
  op: {
    list: {
      name: "list"
      points: [
        {
          contract: {
            id: "GET /users"
            json: "{\"operationId\":\"getAllUsers\",\"parameters\":[],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"items\":{\"description\":\"User object with profile information\",\"properties\":{\"email\":{\"description\":\"User email address\",\"example\":\"john.doe@example.com\",\"format\":\"email\",\"type\":\"string\"},\"firstName\":{\"description\":\"User's first name\",\"example\":\"John\",\"type\":\"string\"},\"id\":{\"description\":\"User ID\",\"example\":1,\"type\":\"integer\"},\"lastName\":{\"description\":\"User's last name\",\"example\":\"Doe\",\"type\":\"string\"},\"username\":{\"description\":\"Username\",\"example\":\"john_doe\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"Successful response with list of users\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/users"
          segments: [
            {
              lit: "users"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
